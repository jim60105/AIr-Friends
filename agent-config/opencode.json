{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "gemini": {
      "models": {},
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}"
      }
    },
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4-pro": {}
      },
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}",
        "headers": {
          "X-Title": "AIr-Friends",
          "HTTP-Referer": "https://github.com/jim60105/AIr-Friends"
        }
      }
    }
  },
  "autoupdate": false,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "default_agent": "build",
  "agent": {
    "build": {
      "mode": "primary",
      "prompt": "{file:/app/prompts/system_prompt_override.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "todoread": "allow",
        "todowrite": "allow",
        "skill": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "codesearch": "allow",
        "task": "deny",
        "doom_loop": "deny",
        "question": "deny",
        "edit": "ask",
        "bash": {
          "*": "deny",
          "||": "deny",
          "&&": "deny",
          "deno run *skills/*/scripts/*.ts*": "allow",
          "*/skills/*/scripts/*.ts*": "allow",
          "agent-browser *": "ask",
          "rg *": "ask",
          "cat *": "ask",
          "head *": "ask",
          "tail *": "ask",
          "ls *": "ask",
          "find *": "ask",
          "wc *": "ask",
          "file *": "ask",
          "tree *": "ask",
          "jq *": "ask",
          "bc *": "deny",
          "pdftotext *": "ask",
          "pdfinfo *": "ask",
          "pdfimages *": "ask",
          "pdftoppm *": "ask",
          "pandoc *": "ask",
          "exiftool *": "ask",
          "ffmpeg *": "ask",
          "ffprobe *": "ask",
          "magick *": "ask",
          "convert *": "ask",
          "identify *": "ask",
          "mogrify *": "ask",
          "unzip *": "ask",
          "zip *": "ask",
          "7zz *": "ask",
          "zola *": "deny",
          "echo *": "deny",
          "git *": "deny",
          "python *": "deny",
          "python3 *": "deny",
          "pip *": "deny",
          "pip3 *": "deny",
          "gcc *": "deny",
          "g++ *": "deny",
          "make *": "deny",
          "strace *": "deny",
          "mkdir *": "deny"
        },
        "external_directory": {
          "*": "deny",
          "~/.agents/skills/**": "allow",
          "/home/deno/.agents/skills/**": "allow",
          "/app/data/agent-workspace/**": "allow",
          "/app/data/workspaces/*/tmp/**": "allow"
        }
      }
    },
    "yolo": {
      "mode": "primary",
      "prompt": "{file:/app/prompts/system_prompt_override.md}",
      "permission": {
        "*": "allow"
      }
    }
  }
}
