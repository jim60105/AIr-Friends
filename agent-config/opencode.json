{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "gemini": {
      "models": {},
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}"
      }
    },
    "openrouter": {
      "models": {
        "deepseek/deepseek-v3.2": {}
      },
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },
  "autoupdate": false,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "agent": {
    "build": {
      "mode": "primary",
      "prompt": "{file:/app/prompts/system_prompt_override.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "todoread": "allow",
        "todowrite": "allow",
        "skill": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "codesearch": "allow",
        "task": "deny",
        "doom_loop": "deny",
        "question": "deny",
        "edit": {
          "*": "deny",
          "data/agent-workspace/**/*.md": "allow",
          "data/agent-workspace/**/*.txt": "allow",
          "$AGENT_WORKSPACE/**/*.md": "allow",
          "$AGENT_WORKSPACE/**/*.txt": "allow",
          "/app/data/agent-workspace/**/*.md": "allow",
          "/app/data/agent-workspace/**/*.txt": "allow",
          "$TMPDIR/**": "allow"
        },
        "bash": {
          "*": "deny",
          "||": "deny",
          "&&": "deny",
          "deno run *skills/*/scripts/*.ts*": "allow",
          "*/skills/*/scripts/*.ts*": "allow",
          "agent-browser *": "allow",
          "rg *": "allow",
          "curl *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "ls *": "allow",
          "find *": "allow",
          "wc *": "allow",
          "git *": "allow",
          "mkdir *": "allow",
          "echo *": "deny",
          "zola *": "allow"
        },
        "external_directory": {
          "*": "deny",
          "~/.agents/skills/**": "allow",
          "/home/deno/.agents/skills/**": "allow",
          "/home/deno/.copilot/skills/**": "allow",
          "data/agent-workspace/**": "allow",
          "$AGENT_WORKSPACE/**": "allow",
          "/app/data/agent-workspace/**": "allow",
          "$TMPDIR/**": "allow",
          "/tmp/**": "allow"
        }
      }
    }
  }
}
