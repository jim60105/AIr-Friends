{
  "name": "@air-friends/core",
  "version": "0.35.0",
  "exports": "./src/main.ts",
  "unstable": ["net"],
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/crypto": "jsr:@std/crypto@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.17",
    "@std/yaml": "jsr:@std/yaml@^1.0.0",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.0",
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "@std/json": "jsr:@std/json@^1.0.0",
    "@std/flags": "jsr:@std/flags@^0.224.0",
    "discord.js": "npm:discord.js@^14.0.0",
    "html-to-text": "npm:html-to-text@^9.0.5",
    "mailparser": "npm:mailparser@^3.9.39",
    "misskey-js": "npm:misskey-js@2026.10.0",
    "imapflow": "npm:imapflow@^1.7.8",
    "@agentclientprotocol/sdk": "npm:@agentclientprotocol/sdk@^0.14.1",
    "@node-rs/jieba": "npm:@node-rs/jieba@^2",
    "nodemailer": "npm:nodemailer@^7.0.13",
    "prom-client": "npm:prom-client@^15",
    "ventojs": "https://cdn.jsdelivr.net/gh/ventojs/vento@2.2.0/mod.ts",
    "ventojs/": "https://cdn.jsdelivr.net/gh/ventojs/vento@2.2.0/",
    "@core/": "./src/core/",
    "@platforms/": "./src/platforms/",
    "@skills/": "./src/skills/",
    "@types/": "./src/types/",
    "@utils/": "./src/utils/",
    "@acp/": "./src/acp/"
  },
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-read --allow-write --allow-env --allow-run --allow-ffi src/main.ts",
    "start": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run --allow-ffi --allow-sys src/main.ts",
    "start:config": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run --allow-ffi --allow-sys src/main.ts --config",
    // `--parallel` is deliberately NOT used: Deno runs parallel test modules in one process, so
    // `Deno.env` mutations leak between concurrently running files. The env-override tests set
    // and restore process-global variables, so a neighbour could observe a transient value and
    // fail on an unrelated assertion (observed on config-loader, scripts and agent-factory-omp).
    "test": "deno test --allow-net --allow-read --allow-write --allow-env --allow-run --allow-ffi --allow-sys",
    "test:watch": "deno test --allow-net --allow-read --allow-write --allow-env --allow-run --allow-ffi --allow-sys --watch",
    "test:coverage": "deno test --allow-net --allow-read --allow-write --allow-env --allow-run --allow-ffi --allow-sys --coverage=coverage",
    "coverage:report": "deno coverage coverage --exclude='tests/'",
    "test:coverage:lcov": "deno test --allow-net --allow-read --allow-write --allow-env --allow-run --allow-ffi --allow-sys --coverage=coverage && deno coverage coverage --lcov --output=coverage.lcov --exclude='tests/'",
    "test:unit": "deno test --allow-net --allow-read --allow-write --allow-env --allow-run --allow-ffi --allow-sys tests/ --ignore=tests/integration",
    "test:integration": "deno test --allow-net --allow-read --allow-write --allow-env --allow-run --allow-ffi --allow-sys tests/integration",
    "ci": "deno task fmt:check && deno task lint && deno task check && deno test --allow-net --allow-read --allow-write --allow-env --allow-run --allow-ffi --allow-sys",
    "fmt": "deno fmt src/ tests/",
    "fmt:check": "deno fmt --check src/ tests/",
    "lint": "deno lint src/ tests/",
    "bundle:omp-extension": "sh scripts/omp/bundle-omp-extension.sh . build/omp-extension deno.lock",
    "prepare:omp-natives": "deno run --allow-read --allow-write --allow-env --allow-run scripts/omp/prepare-native-cache.ts",
    "check": "deno check src/main.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "useTabs": false,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "exclude": ["src/dashboard/public/"]
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  }
}
